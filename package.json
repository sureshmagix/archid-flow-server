{
  "name": "archidflow-server",
  "version": "1.0.0",
  "description": "Node.js backend for ArchidFlow React Native IoT app (HTTP + MQTT + MongoDB)",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon --exec node src/server.js",
    "start": "cross-env NODE_ENV=production node src/server.js",
    "start:pm2": "cross-env NODE_ENV=production pm2 start src/server.js --name archidtech-server",
    "pm2:logs": "pm2 logs archidtech-server",
    "pm2:restart": "pm2 restart archidtech-server",
    "pm2:stop": "pm2 stop archidtech-server",
    "pm2:delete": "pm2 delete archidtech-server"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "mqtt": "^5.7.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.10"
  },
  "keywords": [
    "archidtech",
    "archidflow",
    "iot",
    "mqtt",
    "nodejs",
    "mongodb",
    "express"
  ],
  "author": "ArchidTech",
  "license": "MIT"
}
