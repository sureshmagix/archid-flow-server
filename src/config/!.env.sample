# =========================================================
# 🌍 ArchidTech IoT Server - Environment Configuration
# =========================================================
# Rename this file to `.env.development` or `.env.production`
# and fill in actual values before running the server.
# =========================================================

# ---------------------------------
# Server Settings
# ---------------------------------
# development | production
NODE_ENV=development

# Local or public port
PORT=3001

# ---------------------------------
# MongoDB Connection
# ---------------------------------
# For local development:
# mongodb://127.0.0.1:27017/archidtech_dev
#
# For production (with auth):
# mongodb://username:password@localhost:27017/archidtech_prod?authSource=admin
MONGODB_URI=

# ---------------------------------
# JWT Authentication
# ---------------------------------
# Long random secret key for signing tokens
JWT_SECRET=
# Token expiry period (e.g., 7d, 1h, 30m)
JWT_EXPIRES_IN=7d

# ---------------------------------
# MQTT Broker
# ---------------------------------
# Example local broker: ws://localhost:9001
# Example production broker: ws://archidtech.in:9001
MQTT_URL=

# ---------------------------------
# IoT Namespace
# ---------------------------------
# Used for MQTT client identification
IOT_NAMESPACE=archidtech

# =========================================================
# END OF FILE
# =========================================================


